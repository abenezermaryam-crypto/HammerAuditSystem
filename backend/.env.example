PORT=5000
NODE_ENV=development
# Set to the exact number of trusted reverse proxies in front of this service (often 1).
TRUST_PROXY_HOPS=0

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=minimarket_audit_db

# Required: generate a unique random value of at least 32 bytes; do not commit it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required: comma-separated exact HTTP(S) origins; no paths or wildcard.
CORS_ORIGIN=

# SMTP account used to deliver generic password-reset links (never commit credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:8081
